#!/bin/sh
#set -euo

MAX_RESULTS=20
EXTRACTOR="ytsearch"

search(){
  yt-dlp \
    --quiet \
    --flat-playlist \
    --no-warnings \
    --skip-download \
    "$EXTRACTOR$MAX_RESULTS:$1" \
    --print "%(webpage_url)s - %(title)s - %(uploader)s - %(duration_string)s - %(view_count)s"
}

usage(){
printf "peek [-h] query
-h: print this help section."
}

while getopts 'h' flag; do
  case "${flag}" in
    h) usage ;;
    *) exit 1 ;;
  esac
done

shift $((OPTIND-1))
if [ -n "$1" ]; then
  search "$1"
else
  echo "ERROR: No search query specified"
  exit 1
fi

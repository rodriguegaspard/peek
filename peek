#!/bin/sh

MAX_RESULTS=20
SP_PARAMETER="EgIQAQ%253D%253D"

youtube_search(){
  QUERY_URL="https://www.youtube.com/results?search_query="
  QUERY=$(printf %s "$1" | jq -sRr @uri)
  RESULTS_PER_PAGE=20
  RESULT=""
  for PAGE in $(seq 0 $(( (MAX_RESULTS - 1) / RESULTS_PER_PAGE ))); do
    PAGE_PARAMETER=""
    if [ "$PAGE" -gt 0 ]; then
      PAGE_PARAMETER="&p=$((PAGE + 1))"
    fi
    RESPONSE=$(curl -s --compressed "$QUERY_URL$QUERY&sp=$SP_PARAMETER&hl=en&gl=US$PAGE_PARAMETER" | perl -0777 -ne 'print $1 if /var ytInitialData = (.*?);\s*<\/script>/s')
    JSON=$(echo "$RESPONSE" | jq -r --argjson limit "$MAX_RESULTS" '
    [
    .. | objects |
      select(has("videoRenderer")) |
      .videoRenderer | {
        title: .title.runs[0].text,
            url: ("https://www.youtube.com/watch?v=" + .videoId),
            author: .longBylineText.runs[0].text,
            published: .publishedTimeText.simpleText,
            duration: .lengthText.simpleText,
            views: .viewCountText.simpleText,
            is_live: (.badges // [] | any(.metadataBadgeRenderer.style == "BADGE_STYLE_TYPE_LIVE_NOW")),
            is_premiere: (.badges // [] | any(.metadataBadgeRenderer.label == "Premiere")),
            is_upcoming: (.upcomingEventData != null),
            upcoming_timestamp: (.upcomingEventData?.startTime // null),
            concurrent_viewers: (.viewCountText.runs[0].text // null)
          }
        ] | .[:$limit]
        ' 2>/dev/null)
        if [ -z "$RESULT" ]; then
          RESULT="$JSON"
        fi
        RESULT_COUNT=$(echo "$JSON" | tail -n +2 | wc -l)
        if [ "$RESULT_COUNT" -lt "$RESULTS_PER_PAGE" ]; then
          break
        fi
    done
    echo "$RESULT"
}

print_table(){
  RESULT=$(youtube_search "$1")
  TABLE=$(echo "$RESULT" | jq -r '
  ["TITLE", "URL", "CHANNEL", "PUBLISHED", "DURATION", "VIEWS"],
  (.[] | [
    (.title | if length > 50 then .[0:47] + "..." else . end),
    .url, 
    (.author | if length > 30 then .[0:27] + "..." else . end),
    (if .is_live then "LIVE" 
     elif .is_premiere then "PREMIERE" 
     elif .is_upcoming then "UPCOMING"
     else .published end),
    (if .is_live then "LIVE" 
     elif .is_premiere then .upcoming_timestamp
     elif .is_upcoming then .upcoming_timestamp
     else .duration end),
    (if .is_live then .concurrent_viewers else .views end)
  ])
  | @tsv
  ' 2>/dev/null)
  printf '%s' "$TABLE" | column -t -s "$(printf '\t')"
}

youtube_select() {
    VIDEO_DATA="$(youtube_search "$1")"
    if [ -z "$VIDEO_DATA" ] || [ "$VIDEO_DATA" = "[]" ]; then
        echo "No videos found."
        return 1
    fi
    DELIMITER="$(printf '\037')"
    VIDEO_LIST="$(echo "$VIDEO_DATA" | jq -r --arg DELIMITER "$DELIMITER" '
      .[] | 
      "\(.url)" + $DELIMITER +
      "\(.title)" + $DELIMITER +
      "\(.author)" + $DELIMITER +
      (if .is_live then "LIVE" 
       elif .is_premiere then "PREMIERE" 
       elif .is_upcoming then "UPCOMING"
       else .published end) + $DELIMITER +
      (if .is_live then "LIVE" 
       elif .is_premiere then .upcoming_timestamp
       elif .is_upcoming then .upcoming_timestamp
       else .duration end) + $DELIMITER +
      (if .is_live then .concurrent_viewers else .views end)
    ')"
    SELECTED_URLS="$(echo "$VIDEO_LIST" | fzf \
        --multi \
        --with-nth=2 \
        --delimiter="$DELIMITER" \
        --preview='printf "Title: %b\nAuthor: %b\nPublished: %b\nDuration: %b\nViews: %b\n" {2} {3} {4} {5} {6}' \
        --preview-window='right:30%:wrap' \
        --border \
        --prompt='Select videos (TAB for multiple): ' \
        --bind='ctrl-a:select-all,ctrl-d:deselect-all' \
        --header='↑/↓ to navigate | TAB to select | Enter to confirm | Ctrl-A to select all | Ctrl-D to deselect all' \
        | cut -d"$(printf '\037')" -f1)"
    
    if [ -z "$SELECTED_URLS" ]; then
        echo "No videos selected"
        return 1
    else
      printf '%s\n' "$SELECTED_URLS" | while IFS= read -r URL; do
        mpv "$URL"
      done
    fi
}

youtube_sp_parameter(){
  case "$1" in
    "hour")   SP_PARAMETER="EgIIAQ%253D%253D" ;;
    "today")  SP_PARAMETER="EgIIAg%253D%253D" ;;
    "week")   SP_PARAMETER="EgIIAw%253D%253D" ;;
    "month")  SP_PARAMETER="EgIIBA%253D%253D" ;;
    "year")   SP_PARAMETER="EgIIBQ%253D%253D" ;;
    "video")  SP_PARAMETER="EgIQAQ%253D%253D" ;;
    "live")   SP_PARAMETER="EgJAAQ%253D%253D" ;;
    "short")  SP_PARAMETER="EgQQARgB" ;;
    "long")   SP_PARAMETER="EgQQARgC" ;;
    "local")  SP_PARAMETER="EgO4AQ%253D%253D" ;;
    "newest") SP_PARAMETER="CAISAhAB" ;;
    "views")  SP_PARAMETER="CAMSAhAB" ;;
    "rating") SP_PARAMETER="CAESAhAB" ;;
    *)        SP_PARAMETER="EgIQAQ%253D%253D" ;;
  esac
}

max_results(){
  case "${1}" in
    ''|*[!0-9]*) echo "ERROR: -n flag only accepts a valid integer." && exit 0 ;;
    *) MAX_RESULTS="$1" ;;
  esac
}

usage(){
  printf "peek [-h] query
  -n: number of results to display (defaults to 20).
  -p: optional sp parameter for YouTube search (hour, today, week, month, year, video, live, short, long, local, newest, views, rating).
  -i : interactive mode (requires fzf)
  -h: print this help section."
}

while getopts 'n:p:ih' flag; do
  case "${flag}" in
    n) max_results "$OPTARG" ;;
    p) youtube_sp_parameter "$OPTARG" ;;
    i) INTERACTIVE_MODE=true ;;
    h) usage ;;
    *) exit 1 ;;
  esac
done

shift $((OPTIND-1))

if [ -z "$1" ]; then
  echo "ERROR: No search query specified"
  exit 1
fi

if [ "$INTERACTIVE_MODE" = true ]; then
  youtube_select "$1"
else
  print_table "$1"
fi

